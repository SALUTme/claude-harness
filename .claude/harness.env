# Настройки обвязки harness-setup. Меняет только человек: агенту запись сюда запрещена хуками.

# 1 включает гейты проверки. Для нового проекта держи 0, пока не появился первый настоящий тест.
HARNESS_GATES_ACTIVE=0

# Быстрая проверка после каждой правки кода: линтер, типы, быстрые тесты. Цель до 30 секунд.
HARNESS_FAST_CHECK_CMD=""

# Полный набор тестов для гейта коммита и гейта завершения хода.
HARNESS_TEST_CMD=""

# Файлы, после правки которых быстрая проверка не запускается. Это же выражение отсеивает файлы для гейта конца хода.
# Для режима «исследование»: '^(docs|\.harness)/'
HARNESS_CHECK_SKIP_REGEX='(\.(md|mdx|txt|rst)$|^(docs|wiki|raw)/)'

# Папки, изменения в которых не включают гейт конца хода. Гейт коммита запускает тесты в любом случае.
# Для режима «исследование»: '^(docs|\.harness|\.claude)/', чтобы правки вики проверялись.
HARNESS_GATE_EXCLUDE_REGEX='^(docs|wiki|raw|\.harness|\.claude)/'

# Сколько правок одного файла за сессию до предупреждения о зацикливании.
HARNESS_MAX_EDITS_PER_FILE=8

# 1 требует обновить docs/STATE.md перед завершением хода с изменённым кодом.
HARNESS_REQUIRE_STATE_UPDATE=1

# Сколько раз подряд гейт завершения хода блокирует при красных тестах, прежде чем отпустить и позвать человека.
HARNESS_STOP_MAX_BLOCKS=3

# Файлы окружения без секретов, которые агенту можно писать. Регулярное выражение по имени файла в нижнем регистре.
HARNESS_ENV_FIXTURE_REGEX='^\.env\.(example|sample|template|dist|test)$'

# 1 запускает подготовку окружения .claude/hooks/project-setup.sh в начале сессий на этом компьютере. В облаке она запускается всегда.
HARNESS_ENV_SETUP_LOCAL=0
